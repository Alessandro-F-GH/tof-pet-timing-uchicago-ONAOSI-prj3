{
  "name": "onishi_cnn_timing_wide_49V_test",
  "preprocessing_config": "../../preprocessing/default_ctr.json",
  "mode": "timing_to_timing",
  "model": "onishi_cnn",
  "window": {
    "start": -2.0,
    "end": 30.0
  },
  "resampling": {
    "policy": "repeated_holdout",
    "seed": 1001,
    "n_bootstrap": 50,
    "validation_fraction": 0.2,
    "test_fraction": 0.5,
    "minimum_events_per_split": 50
  },
  "fit": {
    "histogram_bin_width_ps": 10.0,
    "bootstrap_samples": 500
  },
  "ml_input": {
    "subsampling": 1
  },
  "ml_output": {
    "max_abs_ps": 2000.0
  },
  "output_dir": "results/studies/FBK/onishi_cnn_49V_test/timing_wide"
}
