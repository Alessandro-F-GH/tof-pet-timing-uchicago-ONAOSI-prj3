{
  "model": "cnn",
  "architecture": {
    "channels": [16, 32, 64],
    "kernels": [9, 7, 5],
    "strides": [2, 2, 2],
    "dilations": [1, 1, 1],
    "adaptive_pool_length": 128,
    "pooling": "avg_max",
    "dense_units": [32]
  },
  "parameters": {
    "learning_rate": [0.001],
    "weight_decay": [0.00001]
  },
  "training": {
    "device": "auto",
    "epochs": 350,
    "batch_size": 64,
    "patience": 30,
    "min_delta_ps": 0.05,
    "gradient_clip_norm": 10.0
  }
}
