{
  "model": "cnn",
  "architecture": {
    "channels": [
        16,
        32,
        64
      ],

      "kernel_sizes": [
        33,
        15,
        13
      ],

      "strides": [
        2,
        4,
        4
      ],

      "dilations": [
        1,
        1,
        2
      ],
      
    "adaptive_pool_length": 128,
    "pooling": "avg_max",
    "dense_units": [32]
  },
  "parameters": {
    "learning_rate": [ 0.001],
    "batch_size": [128],
    "weight_decay": [1e-5 ]
  },
  "training": {
    "device": "auto",
    "epochs": 300,
    "batch_size": 64,
    "patience": 10,
    "min_delta": 0.01,
    "gradient_clip_norm": 10.0
  }
}
