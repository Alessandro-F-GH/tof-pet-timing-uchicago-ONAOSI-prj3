{
  "model": "cnn",
  "architecture": {
    "channels": [16, 32, 64],
    "kernels": [33, 15, 13],
    "strides": [2, 4, 4],
    "dilations": [1, 1, 2],
    "dense_units": [32]
  },
  "parameters": {
    "learning_rate": [0.001],
    "weight_decay": [0.00001]
  },
  "training": {
    "device": "auto",
    "epochs": 350,
    "batch_size": 64,
    "patience": 30,
    "min_delta_ps": 0.05,
    "gradient_clip_norm": 10.0
  }
}
