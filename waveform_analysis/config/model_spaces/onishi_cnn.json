{
  "model": "onishi_cnn",
  "optimization": {
    "strategy": "grid"
  },
  "architecture": {
    "channels": [32, 64],
    "kernels": [5, 3],
    "dense_units": 256
  },
  "parameters": {
    "learning_rate": {
      "type": "categorical",
      "choices": [1e-3, 1e-4, 1e-5]
    },
    "batch_size": {
      "type": "categorical",
      "choices": [32, 128]
    }
  },
  "training": {
    "device": "auto",
    "epochs": 100,
    "batch_size": 32,
    "lr_decay_epochs": [30, 60],
    "lr_decay_factor": 0.1
  },
  "verbose": false
}
