{
  "model": "onishi_cnn",
   "optimization": {
    "strategy": "optuna",
    "sampler": "tpe",
    "n_trials": 10,
    "n_startup_trials": 5
  },
  "architecture": {
    "channels": [32, 64],
    "kernels": [5, 3],
    "dense_units": 256
  },
  "parameters": {
    "learning_rate": {
      "type": "float",
      "low": 1e-5,
      "high": 1e-2,
      "log": true
    },
    "batch_size": {
      "type": "fixed",
      "value": 32
    }
  },
  "training": {
    "device": "auto",
    "epochs": 100,
    "batch_size": 32,
    "lr_decay_epochs": [30, 60],
    "lr_decay_factor": 0.1
  },
  "verbose": false
}
