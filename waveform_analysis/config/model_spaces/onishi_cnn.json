{
  "model": "onishi_cnn",
  "optimization": {
    "strategy": "fixed"
  },
  "architecture": {
    "channels": [32, 64],
    "kernels": [5, 3],
    "dense_units": 256
  },
  "parameters": {
    "learning_rate": {
      "type": "fixed",
      "value": 1e-4
    },
    "batch_size": {
      "type": "fixed",
      "value": 32
    }
  },
  "training": {
    "device": "auto",
    "epochs": 50,
    "batch_size": 32,
    "lr_decay_epochs": [15, 30],
    "lr_decay_factor": 0.1
  },
  "verbose": false
}
