{
  "model": "shared_linear_ridge",
  "optimization": {
    "strategy": "optuna",
    "sampler": "tpe",
    "n_trials": 20,
    "n_startup_trials": 5
  },
  "parameters": {
    "ridge_alpha": {
      "type": "float",
      "low": 1e-6,
      "high": 10.0,
      "log": true
    }
  },
  "training": {
    "solver": "lsqr",
    "tol": 1e-6
  },
  "verbose": false
}
