{
  "model": "mlp",
  "parameters": {
    "architecture": [
      [
        128,
        64
      ]
    ],
    "activation": [
      "silu"
    ],
    "learning_rate": [
      0.001,
      0.0003
    ],
    "batch_size": [
      128
    ]
  },
  "training": {
    "device": "auto",
    "epochs": 600,
    "patience": 20,
    "min_delta": 0.01,
    "gradient_clip_norm": 10,
    "early_stopping_fraction": 0.2,
    "gradient_early_stop": true,
    "gradient_min_norm": 0.00001,
    "gradient_patience": 4
  },
  "verbose": false
}
