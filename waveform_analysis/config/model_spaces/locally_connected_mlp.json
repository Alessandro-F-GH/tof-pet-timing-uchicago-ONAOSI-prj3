{
  "model": "locally_connected_mlp",
  "optimization": {
    "strategy": "optuna",
    "sampler": "tpe",
    "n_trials": 50,
    "n_startup_trials": 10
  },
  "parameters": {
    "architecture": {
      "type": "fixed",
      "value": [128]
    },
    "activation": {
      "type": "fixed",
      "value": "relu"
    },
    "layer1_kernel_samples": {
      "type": "fixed",
      "value": 3
    },
    "layer1_stride_samples": {
      "type": "fixed",
      "value": 1
    },
    "layer2_kernel_positions": {
      "type": "fixed",
      "value": 3
    },
    "layer2_stride_positions": {
      "type": "fixed",
      "value": 1
    },
    "max_correction_ps": {
      "type": "categorical",
      "choices": [60, 120, 200]
    },
    "learning_rate": {
      "type": "float",
      "low": 0.0003,
      "high": 0.01,
      "log": true
    },
    "batch_size": {
      "type": "categorical",
      "choices": [16, 32, 128, 256]
    }
  },
  "training": {
    "device": "auto",
    "optimizer": "adam",
    "epochs": 1000,
    "patience": 50,
    "min_delta": 0.1,
    "gradient_clip_norm": 10,
    "early_stopping_fraction": 0.2,
    "gradient_early_stop": true,
    "gradient_min_norm": 0.00001,
    "gradient_patience": 4
  },
  "verbose": false
}
