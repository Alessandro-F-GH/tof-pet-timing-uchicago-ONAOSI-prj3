{
  "model": "locally_connected_mlp",
  "optimization": {
    "strategy": "optuna",
    "sampler": "tpe",
    "n_trials": 30,
    "n_startup_trials": 10
  },
  "parameters": {
    "architecture": {
      "type": "categorical",
      "choices": [[16], [128]]
    },
    "activation": {
      "type": "fixed",
      "value": "relu"
    },
    "layer1_kernel_samples": {
      "type": "fixed",
      "value": 3
    },
    "layer1_stride_samples": {
      "type": "fixed",
      "value": 1
    },
    "layer2_kernel_positions": {
      "type": "fixed",
      "value": 3
    },
    "layer2_stride_positions": {
      "type": "fixed",
      "value": 1
    },
    "max_correction_ps": {
      "type": "categorical",
      "choices": [20, 60, 120, 200, 500]
    },
    "learning_rate": {
      "type": "float",
      "low": 1e-5,
      "high": 1e-2,
      "log": true
    },
    "batch_size": {
      "type": "categorical",
      "choices": [32, 128, 1024]
    }
  },
  "training": {
    "device": "auto",
    "optimizer": "adam",
    "epochs": 300,
    "patience": 10,
    "min_delta": 0.1,
    "gradient_clip_norm": 10,
    "early_stopping_fraction": 0.2,
    "gradient_early_stop": true,
    "gradient_min_norm": 1e-6,
    "gradient_patience": 4
  },
  "verbose": false
}
