{
  "model": "antisymmetric_mlp",
  "optimization": {
    "strategy": "optuna",
    "sampler": "tpe",
    "n_trials": 20,
    "n_startup_trials": 5
  },
  "parameters": {
    "architecture": {
      "type": "categorical",
      "choices": [[16], [128], [128, 64], [16, 16, 16]]
    },
    "activation": {
      "type": "fixed",
      "value": "relu"
    },
    "learning_rate": {
      "type": "float",
      "low": 1e-5,
      "high": 1e-2,
      "log": true
    },
    "batch_size": {
      "type": "categorical",
      "choices": [32, 128, 1024]
    }
  },
  "training": {
    "device": "auto",
    "epochs": 1000,
    "patience": 50,
    "min_delta": 0.1,
    "gradient_clip_norm": 10,
    "early_stopping_fraction": 0.2,
    "gradient_early_stop": true,
    "gradient_min_norm": 1e-6,
    "gradient_patience": 4,
    "momentum": 0.9
  },
  "verbose": false
}
