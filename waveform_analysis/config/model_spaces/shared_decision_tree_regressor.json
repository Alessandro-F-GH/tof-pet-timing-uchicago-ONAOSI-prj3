{
  "model": "shared_decision_tree_regressor",
  "optimization": {
    "strategy": "grid"
  },
  "parameters": {
    "criterion": {
      "type": "fixed",
      "value": "squared_error"
    },
    "max_depth": {
      "type": "categorical",
      "choices": [
        3,
        5,
        8,
        12
      ]
    },
    "min_samples_leaf": {
      "type": "categorical",
      "choices": [
        10,
        50,
        200
      ]
    },
    "ccp_alpha": {
      "type": "fixed",
      "value": 0
    }
  },
  "diagnostics": {
    "detector_swap": true
  },
  "verbose": false
}
