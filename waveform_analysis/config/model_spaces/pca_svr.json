{
  "model": "pca_svr",
  "parameters": {
    "n_components": [16, 32, 64],
    "C": [0.1, 1.0, 10.0],
    "epsilon_ps": [0.0, 10.0],
    "kernels": {
      "linear": {},
      "rbf": {
        "gamma_scale": [0.25, 1.0, 4.0]
      },
      "poly": {
        "gamma_scale": [0.5, 1.0],
        "degree": [2, 3],
        "coef0": [1.0]
      }
    }
  },
  "pca": {
    "whiten": true,
    "svd_solver": "randomized",
    "seed": 20260815
  },
  "svr": {
    "tolerance": 0.001,
    "max_iterations": 100000,
    "cache_size_mb": 2048,
    "shrinking": true
  },
  "selection_metric": "validation_mse"
}
