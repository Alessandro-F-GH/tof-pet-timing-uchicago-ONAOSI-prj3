{
  "model": "shared_multirocket",
  "optimization": {
    "strategy": "grid"
  },
  "parameters": {
    "n_kernels": {
      "type": "fixed",
      "value": 6250
    },
    "max_dilations_per_kernel": {
      "type": "fixed",
      "value": 32
    },
    "n_features_per_kernel": {
      "type": "fixed",
      "value": 4
    },
    "normalise": {
      "type": "fixed",
      "value": false
    },
    "ridge_alpha": {
      "type": "categorical",
      "choices": [
        1e3,
        1e4,
        1e5,
        1e6
      ]
    }
  },
  "transform": {
    "n_jobs": -1,
    "batch_size": 128
  },
  "training": {},
  "diagnostics": {
    "detector_swap": false
  },
  "verbose": false
}
