{
  "model": "direct_mlp",
  "parameters": {
    "architecture": [[64], [128, 64]],
    "activation": ["relu"],
    "learning_rate": [1e-2, 3e-3, 1e-3, 3e-4],
    "batch_size": [16,32,128]
  },
  "training": {
    "device": "auto",
    "optimizer": "adam",
    "epochs": 1000,
    "patience": 50,
    "min_delta": 0.1,
    "gradient_clip_norm": 10,
    "early_stopping_fraction": 0.2,
    "gradient_early_stop": true,
    "gradient_min_norm": 0.00001,
    "gradient_patience": 4
  },
  "verbose": false
}
