{
  "model": "independent_cnn1d",
  "optimization": {
    "strategy": "optuna",
    "sampler": "tpe",
    "n_trials": 20,
    "n_startup_trials": 5
  },
  "parameters": {
    "architecture": {
      "type": "fixed",
      "value": [64]
    },
    "activation": {
      "type": "fixed",
      "value": "relu"
    },
    "learning_rate": {
      "type": "float",
      "low": 1e-5,
      "high": 1e-2,
      "log": true
    },
    "batch_size": {
      "type": "categorical",
      "choices": [32, 128, 1024]
    },
    "conv_channels": {
      "type": "fixed",
      "value": [16, 32]
    },
    "kernel_samples": {
      "type": "fixed",
      "value": [5, 3]
    }
  },
  "training": {
    "device": "auto",
    "optimizer": "adam",
    "epochs": 1000,
    "patience": 10,
    "min_delta": 0.1,
    "gradient_clip_norm": 10,
    "early_stopping_fraction": 0.2,
    "gradient_early_stop": true,
    "gradient_min_norm": 1e-6,
    "gradient_patience": 4
  },
  "diagnostics": {
    "detector_swap": false
  },
  "verbose": false
}
