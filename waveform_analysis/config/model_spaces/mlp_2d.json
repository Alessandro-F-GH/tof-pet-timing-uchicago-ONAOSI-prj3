{
  "model": "mlp_2d",
  "parameters": {
    "architecture": [
      [
        128,
        64
      ]
    ],
    "activation": [
      "silu"
    ],
    "learning_rate": [
      0.001
    ],
    "batch_size": [
      128
    ],
    "weight_decay": [
      0.00001
    ],
    "loss": [
      "rmse",
      "huber"
    ],
    "huber_delta_ps": [
      20,
      30,
      50
    ],
    "correlation_weight": [
      0,
      0.01,
      0.05,
      0.1
    ]
  },
  "training": {
    "device": "auto",
    "epochs": 300,
    "patience": 10,
    "min_delta": 0.01,
    "gradient_clip_norm": 10,
    "early_stopping_fraction": 0.2
  },
  "verbose": false
}
