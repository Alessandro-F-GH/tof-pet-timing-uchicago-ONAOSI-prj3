{
  "model": "localized_rocket",
  "transform": {
    "n_kernels": 128,
    "kernel_sizes": [7, 9, 11],
    "max_dilation": 32,
    "n_time_bins": 64,
    "features": ["ppv", "max"],
    "seed": 20260815,
    "device": "auto",
    "chunk_size": 512
  },
  "parameters": {
    "alpha": [0.0001, 0.001, 0.01, 0.1, 1.0, 10.0, 100.0]
  },
  "ridge": {
    "solver": "lsqr",
    "tolerance": 0.0001,
    "max_iterations": 2000
  },
  "selection_metric": "validation_mse"
}
