{
  "extends": "../profiles/ctr_default.json",
  "data_config": "../data/full.json",
  "preprocessing_config": "../preprocessing/default_ctr.json",

  "experiment": {
    "name": "full_waveform_new",
    "output_dir": "results/studies/full_waveform_new"
  },

  "models": ["linear_svr","cnn"],

  "modes": {
    "energy_to_energy": {
      "enabled": false,
      "cfd": true
    },
    "energy_to_timing": {
      "enabled": false,
      "cfd": false
    },
    "timing_to_timing": {
      "enabled": true,
      "cfd": false
    }
  },

  "windows_ns": [
    {
      "id": "m2_p30",
      "start_ns": -2.0,
      "end_ns": 30.0
    }
  ],

  "multithreshold": {
    "enabled": true,
    "window_id": "m2_p30",
    "thresholds_mV": [20,50,100.0,200,500],
    "min_thresholds": 5,
    "max_thresholds": 5,
    "kernels": ["linear", "rbf"],
    "C_values": [1.0, 100.0],
    "epsilon_values_ps": [0.0, 60.0],
    "gamma_values": ["scale"],
    "chunk_size": 2048
  },

  "reporting": {
    "xai": {
      "enabled": true
    }
  }
}
