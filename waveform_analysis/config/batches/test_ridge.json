{
  "name": "test_ridge_48V_R1_R2",
  "control_dataset": "../datasets/control_FBK.json",
  "development_dataset": {"root_file": "processed_data/10-05/48V-R1.root", "true_tof_ps": 0.0, "channels": {"energy": [1, 2], "polarities": [1, 1], "timing": [3, 4], "timing_polarities": [1, 1]}},
  "blind_dataset": {"root_file": "processed_data/10-05/48V-R2.root", "true_tof_ps": 0.0, "channels": {"energy": [1, 2], "polarities": [1, 1], "timing": [3, 4], "timing_polarities": [1, 1]}},
  "results": {"root": "results", "folder": "FBK/test_ridge_48V_R1_R2"},
  "save_model": true,
  "protocol": {
    "seed": 1001, "preprocessing_config": "../preprocessing/default_ctr.json",
    "cross_validation": {"folds": 5, "shuffle": true, "metric": "ctr", "minimum_events_per_fold": 20, "pruning": {"enabled": true, "startup_complete_candidates": 2, "min_folds_before_prune": 1, "max_degradation_ps": 5.0, "prune_if_worse_than_led": true, "led_max_degradation_ps": 0.0}},
