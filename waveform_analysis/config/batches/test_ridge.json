    "ml_input": {"subsampling": 1}, "ml_output": {"max_abs_ps": 2000.0}, "runtime": {"prediction_chunk_size": 4096}, "xai": {"enabled": true, "group_size_samples": 8, "max_events": 128}
  },
  "sweep": {"models": ["direct_linear_ridge", "shared_linear_ridge"], "modes": ["timing_to_timing"], "windows": {"onishi": {"start": -1.5, "end": 2.0}}}
}
