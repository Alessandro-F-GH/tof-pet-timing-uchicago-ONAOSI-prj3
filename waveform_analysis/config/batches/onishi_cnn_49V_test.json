{
  "name": "onishi_cnn_49V_test",
  "reference_dataset": "../datasets/control.json",
  "analysis_dataset": {
    "root_file": "processed_data/converted_runs_07-13/49V-490mV.root",
    "true_tof_ps": 0.0,
    "channels": {
      "energy": [1, 2],
      "polarities": [1, 1],
      "timing": [3, 4],
      "timing_polarities": [1, 1]
    }
  },
  "output_dir": "results/studies/FBK/onishi_cnn_49V_test",
  "save_models": "all",
  "protocol": {
    "seed": 1001,
    "preprocessing_config": "../preprocessing/default_ctr.json",
    "model_selection": {"validation_fraction": 0.2},
    "evaluation": {
      "n_replicas": 50,
      "blind_fraction": 0.5,
      "minimum_events_per_split": 50
    },
    "fit": {"histogram_bin_width_ps": 20.0},
    "ml_input": {"subsampling": 1},
    "ml_output": {"max_abs_ps": 2000.0}
  },
  "sweep": {
    "models": ["onishi_cnn"],
    "modes": ["energy_to_energy"],
    "windows": {
      "onishi": {"start": -1.5, "end": 2.0}
    }
  }
}
