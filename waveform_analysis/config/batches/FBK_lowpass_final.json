{
  "name": "FBK_filtered_2GHz_order5_benchmark",
  "control_dataset": "../datasets/control_FBK.json",
  "development_dataset": {
    "root_file": "processed_data/10-05/48V-R1.root",
    "true_tof_ps": 0,
    "channels": {
      "energy": [
        1,
        2
      ],
      "polarities": [
        1,
        1
      ],
      "timing": [
        3,
        4
      ],
      "timing_polarities": [
        1,
        1
      ]
    }
  },
  "blind_dataset": {
    "root_file": "processed_data/10-05/48V-R2.root",
    "true_tof_ps": 0,
    "channels": {
      "energy": [
        1,
        2
      ],
      "polarities": [
        1,
        1
      ],
      "timing": [
        3,
        4
      ],
      "timing_polarities": [
        1,
        1
      ]
    }
  },
  "results": {
    "root": "results",
    "folder": "FBK/filtered_benchmark"
  },
  "save_model": true,
  "protocol": {
    "seed": 1001,
    "preprocessing_config": "../preprocessing/FBK_lowpass_2GHz.json",
    "cross_validation": {
      "folds": 3,
      "shuffle": true,
      "metric": "ctr",
      "minimum_events_per_fold": 50,
      "pruning": {
        "enabled": true,
        "startup_complete_candidates": 3,
        "min_folds_before_prune": 1,
        "max_degradation_ps": 5,
        "prune_if_worse_than_led": true,
        "led_max_degradation_ps": 0
      }
    },
    "bootstrap": {
      "n_resamples": 100
    },
    "fit": {
      "energy_to_energy": {
        "histogram_bin_width_ps": 10
      },
      "timing_to_timing": {
        "histogram_bin_width_ps": 5
      }
    },
    "ml_input": {
      "subsampling": 1
    },
    "ml_output": {
      "max_abs_ps": 2000
    },
    "runtime": {
      "prediction_chunk_size": 4096
    },
    "xai": {
      "enabled": false,
      "group_size_samples": 8,
      "max_events": 4096
    }
  },
  "sweep": {
    "models": [
      "direct_linear_ridge",
      "shared_linear_ridge",
      "onishi_cnn",
      "direct_rdst",
      "direct_multirocket",
      "direct_mlp",
      "direct_decision_tree_regressor",
      "shared_decision_tree_regressor"
    ],
    "modes": [
      "energy_to_energy",
      "timing_to_timing"
    ],
    "windows": {
      "onishi": {
        "start": -1.5,
        "end": 2
      },
      "wide": {
        "start": -2,
        "end": 60
      }
    }
  },
  "multithreshold_reference": {
    "enabled": true,
    "thresholds_mV": [
      30,
      50,
      100
    ],
    "baseline_window_ns": [
      -1.4,
      -1
    ],
    "crossing_window_ns": [
      -0.8,
      1.8
    ],
    "minimum_coverage": 0.9,
    "chunk_size": 128
  }
}
