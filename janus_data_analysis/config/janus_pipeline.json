{
  "paths": {
    "input_dir": "data/07-10",
    "output_dir": "outputs/07-10"
  },
  "files": {
    "data_pattern": "Run*list.dat",
    "recursive": false
  },
  "runs": {
    "include": ["Run4940"],
    "overwrite": []
  },
  "tasks": {
    "streaming_pulse_decode": {"enabled": true, "overwrite": false},
    "candidate_preprocessing": {"enabled": true, "overwrite": false},
    "energy_selection": {"enabled": true, "overwrite": false},
    "matching_training": {"enabled": true, "overwrite": false},
    "matching_model": {"enabled": true, "overwrite": false},
    "preprocessing": {"enabled": true, "overwrite": false},
    "selection": {"enabled": true, "overwrite": false},
    "fit": {"enabled": true, "overwrite": false}
  },
  "channels": {
    "signal_a": 1,
    "time_a": 3,
    "signal_b": 5,
    "time_b": 7
  },
  "preprocessing": {
    "streaming_physical_time": {
      "enabled": true,
      "require_same_board": true,
      "energy_leading_pair_window_ns": 5.0
    },
    "pulse_reconstruction": {
      "deduplicate_exact_edges": true,
      "minimum_tot_ns": 0.0,
      "maximum_energy_tot_ns": 200.0,
      "tot_lead_match_tolerance_ns": 0.05,
      "fallback_when_tot_missing": true,
      "fallback_when_tot_inconsistent": false
    }
  },
  "peak_selection": {
    "min_events": 50,
    "kde_grid_points": 4096,
    "kde_bandwidth_factor": 0.35,
    "min_peak_height_fraction": 0.12,
    "peak_choice": "rightmost_significant",
    "left_sigma_multiplier": 2.0,
    "right_sigma_multiplier": 4.0,
    "minimum_events_in_interval": 5
  },
  "alignment_filter": {
    "enabled": true,
    "method": "robust_mad",
    "z_threshold": 5.0,
    "minimum_scale_lsb": 2.0,
    "minimum_events": 20
  },
  "fit": {
    "min_events": 100,
    "coverage_fraction": 0.90,
    "bin_width_ps": 5.0,
    "bootstrap_samples": 500,
    "led_outlier_rejection": {
      "enabled": true,
      "zscore_limit": 4.0
    }
  },
  "plots": {
    "matching_train": {"enabled": false, "overwrite": false},
    "matching_total": {"enabled": false, "overwrite": false},
    "peak_selection": {"enabled": true, "overwrite": false},
    "timing_fit": {"enabled": true, "overwrite": false},
    "dpi": 180,
    "max_histogram_bins": 120,
    "matching_curve_points": 1000
  },
  "thresholds": {"consistency": "error"},
  "matching_model": {
    "method": "average_delay",
    "training": {
      "window_ns": 10.0,
      "minimum_samples": 20
    },
    "average_delay": {
      "outlier_filter": {
        "enabled": true,
        "z_threshold": 3.5,
        "max_iterations": 8,
        "minimum_scale_lsb": 2.0
      }
    },
    "inference": {
      "candidate_window_ns": 10.0,
      "maximum_deviation_ns": null
    }
  },
  "analysis_output": {
    "large_table_format": "csv",
    "diagnostic_mode": "compact"
  }
}
